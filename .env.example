# Copy to .env for local development. Never commit .env.

# PostgreSQL (Docker Compose). Host port 5433 avoids clashing with a native PostgreSQL on 5432 (D-028).
POSTGRES_USER=sentinelx
POSTGRES_PASSWORD=sentinelx
POSTGRES_DB=sentinelx
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://sentinelx:sentinelx@localhost:5433/sentinelx
# Least-privilege web role (D-035). `npm run db:roles` sets this password on sentinelx_app.
APP_DATABASE_URL=postgresql://sentinelx_app:sentinelx_app_local@localhost:5433/sentinelx

KAFKA_BROKERS=localhost:9092
QDRANT_URL=http://localhost:6333
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SentinelX
