{
  "$id": "https://sentinelx.local/contracts/v1/verdict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structured investigation verdict (CLAUDE.md). Existence of cited IDs is checked in Phase 10.",
  "properties": {
    "verdict": {
      "maxLength": 120,
      "minLength": 3,
      "title": "Verdict",
      "type": "string"
    },
    "confidence": {
      "description": "Model-reported, uncalibrated (D-016)",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "severity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "Severity",
      "type": "string"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^ev_[0-9a-f]{16}$",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array",
      "uniqueItems": true
    },
    "mitre_techniques": {
      "items": {
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Mitre Techniques",
      "type": "array",
      "uniqueItems": true
    },
    "recommendations": {
      "items": {
        "maxLength": 300,
        "minLength": 3,
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Recommendations",
      "type": "array"
    }
  },
  "required": [
    "verdict",
    "confidence",
    "severity",
    "summary",
    "evidence_ids",
    "mitre_techniques",
    "recommendations"
  ],
  "title": "SentinelX verdict v1",
  "type": "object"
}
